# KARYADRISHTI Environment Configuration Example

# Server & Database
PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite:///./karyadrishti.db
# For production PostgreSQL: postgresql://karyadrishti_user:password@localhost:5432/karyadrishti_db

# Security & Auth
JWT_SECRET=karyadrishti_dev_secret_key_change_in_production_32bytes_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS & Domain Settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Integrations & Artifacts
LLM_API_KEY=your_gemini_api_key_here
MODEL_ARTIFACT_PATH=./ml/artifacts/models
PAIMANA_DATA_PATH=./data/raw/paimana

# Feature Flags
ENABLE_ASSISTANT=false
ENABLE_EXTERNAL_NOTIFICATIONS=false
ENVIRONMENT=development
